<?xml version="1.0"?>
<ruleset name="WooCommerce Product Unpublisher">
	<description>Security, i18n and compatibility checks. Style-only rules are intentionally not enforced.</description>

	<file>.</file>
	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/tests/</exclude-pattern>
	<exclude-pattern>/bin/</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<config name="testVersion" value="8.2-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.WP.I18n"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<config name="text_domain" value="woocommerce-product-unpublisher"/>
	<config name="minimum_wp_version" value="6.5"/>
</ruleset>
