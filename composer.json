{
  "name": "woocommerce-product-unpublisher/woocommerce-product-unpublisher",
  "description": "Schedule published WooCommerce products to return to Draft, individually or in bulk.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0",
    "yoast/phpunit-polyfills": "^2.0 || ^3.0",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "ProductUnpublisher\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ProductUnpublisher\\Tests\\": "tests/unit/Support/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "phpcs": "phpcs"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
